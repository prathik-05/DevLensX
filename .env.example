# DevLensX Core Platform Configuration Template

# Relational Application Database URL
DATABASE_URL=sqlite:///./devlensx.db

# Authentication Security Secret (Change in Production!)
JWT_SECRET=devlensx_production_secret_change_me_immediately_987654321

# Unified LLM Provider Keys (Provide AT LEAST ONE key below)
LLM_PROVIDER=auto

# Local inference (no API cost)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
# LLM_PROVIDER=ollama

# Google AI Studio (optional, billable)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE
# OpenRouter (optional, billable)
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE
# OpenAI (optional, billable)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# Embedding & Graph Storage Paths
VECTOR_DIMENSION=384
KUZU_DATABASE_PATH=./devlensx_graph_db
FAISS_INDEX_PATH=./.devlensx-runtime/faiss_index.bin

# Platform URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
